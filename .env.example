PORT=3000
NODE_ENV=development

# Cliente Supabase (PostgREST), usado por la app en runtime.
# Project Settings → API en el dashboard de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Conexion Postgres directa, usada solo por `npm run migrate`.
# Project Settings → Database → Connection string (modo "Transaction pooler").
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

PUBLIC_BASE_URL=http://localhost:3000

# Firma la cookie de sesion (login). Cualquier string largo y random sirve;
# generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional, no lo usa la app: Personal Access Token de Supabase (cuenta
# completa) para que Claude pueda usar la Management API sin pasos manuales
# en el dashboard. Generar en supabase.com/dashboard/account/tokens.
SUPABASE_MANAGEMENT_TOKEN=
